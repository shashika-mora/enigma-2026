# Enigma 2026 Environment Configuration Example
# Copy this file to .env.local and configure your environment variables.
# NEVER commit .env.local or production secrets to Git.

# Organizer Admin Portal Passcode
NEXT_PUBLIC_ADMIN_PASSCODE=your_custom_admin_passcode_here

# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=enigma-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=enigma-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=enigma-2026.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
